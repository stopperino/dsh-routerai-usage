{
  "name": "dsh-routerai-usage",
  "version": "1.4.0",
  "type": "module",
  "description": "Баланс RouterAI и стоимость запросов в веб-интерфейсе DeepSeek Harness: баланс личного кабинета, расход текущей сессии вместе с субагентами, включая генерацию изображений, видео и речи, а также служебные вызовы модели.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "routerai",
    "balance",
    "cost",
    "usage",
    "tokens",
    "spend"
  ],
  "author": "stopperino",
  "homepage": "https://github.com/stopperino/dsh-routerai-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stopperino/dsh-routerai-usage.git"
  },
  "bugs": {
    "url": "https://github.com/stopperino/dsh-routerai-usage/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
