{
  "name": "dsh-routerai-usage",
  "version": "1.0.0",
  "type": "module",
  "description": "RouterAI balance and per-request cost for the DeepSeek Harness Web UI: account balance plus what the current session really spent, subagents included.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "routerai",
    "balance",
    "cost",
    "usage",
    "tokens",
    "spend"
  ],
  "author": "stopperino",
  "homepage": "https://github.com/stopperino/dsh-routerai-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stopperino/dsh-routerai-usage.git"
  },
  "bugs": {
    "url": "https://github.com/stopperino/dsh-routerai-usage/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  }
}
